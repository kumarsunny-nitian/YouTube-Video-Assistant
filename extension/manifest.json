{
  "manifest_version": 3,
  "name": "YouTube AI Chat",
  "version": "1.0",

  "permissions": ["activeTab"],

  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8000/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": ["content.js"],
      "css": ["sidebar.css"]
    }
  ]
}
